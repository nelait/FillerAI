        "Sedan": "Passenger",
        "Coupe": "Passenger",
        "Wagon": "Passenger",
        "SUV": "Light truck",
        "Pickup": "Light truck",
        "Minivan": "Light truck",
        "Cargo van": "Light truck"
      }
    },
    {
      "name": "doors",
      "label": "Doors",
      "screen": "vehicle",
      "control": "select",
      "options": [
        "2",
        "3",
        "4"
      ],
      "follows": "body_style",
      "when": {
        "Sedan": "4",
        "Coupe": "2",
        "Wagon": "4",
        "SUV": "4",
        "Pickup": [
          "2",
          "4"
        ],
        "Minivan": "4",
        "Cargo van": [
          "2",
          "3"
        ]
      }
    },
    {
      "name": "seats",
      "label": "Seating Capacity",
      "screen": "vehicle",
      "control": "select",
      "options": [
        "2",
        "3",
        "4",
        "5",
        "7",
        "8"
      ],
      "follows": "body_style",
      "when": {
        "Sedan": "5",
        "Coupe": "4",
        "Wagon": "5",
        "SUV": [
          "5",
          "7"
        ],
        "Pickup": [
          "3",
          "5"
        ],
        "Minivan": [
          "7",
          "8"
        ],
        "Cargo van": "2"
      }
    },
    {
      "name": "telematics_eligible",
      "label": "Telematics Eligible",
      "screen": "vehicle",
      "control": "select",
      "options": [
        "Yes",
        "No"
      ],
      "follows": "fuel_type",
      "when": {
        "Electric": "Yes",
        "Hybrid": "Yes",
        "Gasoline": [
          "Yes",
          "No"
        ]
      }
    },
    {
      "name": "vin",
      "label": "VIN",
      "screen": "vehicle",
      "required": true,
      "min_length": 17,
      "max_length": 17
    },
    {
      "name": "odometer",
      "label": "Current Odometer",
      "screen": "vehicle",
      "control": "number",
      "minimum": 0,
      "maximum": 300000
    },
    {
      "name": "vehicle_use",
      "label": "Primary Use",
      "screen": "vehicle",
      "control": "select",
      "required": true,
      "options": [
        "Pleasure",
        "Commute",
        "Business",
        "Farm"
      ]
    },
    {
      "name": "annual_mileage_band",
      "label": "Annual Mileage",
      "screen": "vehicle",
      "control": "select",
      "options": [
        "Under 5,000",
        "5,000-7,499",
        "7,500-9,999",
        "10,000-12,499",
        "12,500-14,999",
        "15,000 or more"
      ],
      "follows": "vehicle_use",
      "when": {
        "Pleasure": [
          "Under 5,000",
          "5,000-7,499"
        ],
        "Commute": [
          "7,500-9,999",
          "10,000-12,499"
        ],
        "Business": [
          "12,500-14,999",
          "15,000 or more"
        ],
        "Farm": [
          "5,000-7,499",
          "7,500-9,999"
        ]
      }
    },
    {
      "name": "business_use_rider",
      "label": "Business Use Rider",
      "screen": "vehicle",
      "control": "select",
      "options": [
        "Required",
        "Not required"
      ],
      "follows": "vehicle_use",
      "when": {
        "Pleasure": "Not required",
        "Commute": "Not required",
        "Business": "Required",
        "Farm": "Required"
      }
    },
    {
      "name": "ownership",
      "label": "Ownership",
      "screen": "vehicle",
      "control": "select",
      "required": true,
      "options": [
        "Owned outright",
        "Financed",
        "Leased"
      ]
    },
    {
      "name": "lienholder_required",
      "label": "Lienholder On Policy",
      "screen": "vehicle",
      "control": "select",
      "options": [
        "Yes",
        "No"
      ],
      "follows": "ownership",
      "when": {
        "Owned outright": "No",
        "Financed": "Yes",
        "Leased": "Yes"
      }
    },
    {
      "name": "coverage_tier",
      "label": "Coverage Tier",
      "screen": "coverage",
      "control": "select",
      "required": true,
      "options": [
        "Basic",
        "Standard",
        "Plus",
        "Premier"
      ]
    },
    {
      "name": "collision_deductible",
      "label": "Collision Deductible",
      "screen": "coverage",
      "control": "select",
      "options": [
        "250",
        "500",
        "1000",
        "2000"
      ],
      "follows": "coverage_tier",
      "when": {
        "Basic": "2000",
        "Standard": "1000",
        "Plus": "500",
        "Premier": "250"
      }
    },
    {
      "name": "comprehensive_deductible",
      "label": "Comprehensive Deductible",
      "screen": "coverage",
      "control": "select",
      "options": [
        "100",
        "250",
        "500",
        "1000"
      ],
      "follows": "coverage_tier",
      "when": {
        "Basic": "1000",
        "Standard": "500",
        "Plus": "250",
        "Premier": "100"
      }
    },
    {
      "name": "bodily_injury_limit",
      "label": "Bodily Injury Limit",
      "screen": "coverage",
      "control": "select",
      "options": [
        "25/50",
        "50/100",
        "100/300",
        "250/500"
      ],
      "follows": "coverage_tier",
      "when": {
        "Basic": "25/50",
        "Standard": "50/100",
        "Plus": "100/300",
        "Premier": "250/500"
      }
    },
    {
      "name": "property_damage_limit",
      "label": "Property Damage Limit",
      "screen": "coverage",
      "control": "select",
      "options": [
        "25000",
        "50000",
        "100000",
        "250000"
      ],
      "follows": "coverage_tier",
      "when": {
        "Basic": "25000",
        "Standard": "50000",
        "Plus": "100000",
        "Premier": "250000"
      }
    },
    {
      "name": "uninsured_motorist",
      "label": "Uninsured Motorist",
      "screen": "coverage",
      "control": "select",
      "options": [
        "50/100",
        "100/300",
        "250/500",
        "Declined"
      ],
      "follows": "coverage_tier",
      "when": {
        "Basic": "Declined",
        "Standard": "50/100",
        "Plus": "100/300",
        "Premier": "250/500"
      }
    },
    {
      "name": "roadside_assistance",
      "label": "Roadside Assistance",
      "screen": "coverage",
      "control": "select",
      "options": [
        "No",
        "Yes"
      ],
      "follows": "coverage_tier",
      "when": {
        "Basic": "No",
        "Standard": [
          "No",
          "Yes"
        ],
        "Plus": "Yes",
        "Premier": "Yes"
      }
    },
    {
      "name": "rental_reimbursement",
      "label": "Rental Reimbursement",
      "screen": "coverage",
      "control": "select",
      "options": [
        "No",
        "Yes"
      ],
      "follows": "coverage_tier",
      "when": {
        "Basic": "No",
        "Standard": "No",
        "Plus": "Yes",
        "Premier": "Yes"
      }
    },
    {
      "name": "glass_coverage",
      "label": "Full Glass Coverage",
      "screen": "coverage",
      "control": "select",
      "options": [
        "No",
        "Yes"
      ],
      "follows": "coverage_tier",
      "when": {
        "Basic": "No",
        "Standard": [
          "No",
          "Yes"
        ],
        "Plus": "Yes",
        "Premier": "Yes"
      }
    },
    {
      "name": "gap_coverage",
      "label": "Gap Coverage",
      "screen": "coverage",
      "control": "select",
      "options": [
        "No",
        "Yes"
      ],
      "follows": "coverage_tier",
      "when": {
        "Basic": "No",
        "Standard": "No",
        "Plus": [
          "No",
          "Yes"
        ],
        "Premier": "Yes"
      }
    },
    {
      "name": "accident_forgiveness",
      "label": "Accident Forgiveness",
      "screen": "coverage",
      "control": "select",
      "options": [
        "No",
        "Yes"
      ],
      "follows": "coverage_tier",
      "when": {
        "Basic": "No",
        "Standard": "No",
        "Plus": "No",
        "Premier": "Yes"
      }
    },
    {
      "name": "premium_band",
      "label": "Premium Band",
      "screen": "coverage",
      "control": "select",
      "options": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ],
      "semantic_type": "enum",
      "follows": [
        "coverage_tier",
        "vehicle_class"
      ],
      "when": {
        "Basic|Passenger": "A",
        "Basic|Light truck": "B",
        "Standard|Passenger": "B",
        "Standard|Light truck": "C",
        "Plus|Passenger": "C",
        "Plus|Light truck": "D",
        "Premier|Passenger": "D",
        "Premier|Light truck": "E"
      },
      "help_text": "Set by the tier and the rating class together, not by either alone."
    },
    {
      "name": "prior_claims",
      "label": "Claims In Last 5 Years",
      "screen": "history",
      "control": "select",
      "required": true,
      "options": [
        "0",
        "1",
        "2",
        "3 or more"
      ]
    },
    {
      "name": "claim_free_discount",
      "label": "Claim-Free Discount",
      "screen": "history",
      "control": "select",
      "options": [
        "Yes",
        "No"
      ],
      "follows": "prior_claims",
      "when": {
        "0": "Yes",
        "1": "No",
        "2": "No",
        "3 or more": "No"
      }
    },
    {
      "name": "prior_carrier",
      "label": "Prior Carrier",
      "screen": "history",
      "max_length": 40
    },
    {
      "name": "continuous_coverage",
      "label": "Continuous Coverage",
      "screen": "history",
      "control": "select",
      "options": [
        "None",
        "Under 1 year",
        "1-3 years",
        "Over 3 years"
      ]
    },
    {
      "name": "defensive_driving_course",
      "label": "Defensive Driving Course",
      "screen": "history",
      "control": "select",
      "options": [
        "Yes",
        "No"
      ]
    },
    {
      "name": "good_student_discount",
      "label": "Good Student Discount",
      "screen": "history",
      "control": "select",
      "options": [
        "Yes",
        "No"
      ]
    },
    {
      "name": "payment_plan",
      "label": "Payment Plan",
      "screen": "billing",
      "control": "select",
      "required": true,
      "options": [
        "Paid in full",
        "Quarterly",
        "Monthly"
      ]
    },
    {
      "name": "installments",
      "label": "Number Of Installments",
      "screen": "billing",
      "control": "select",
      "options": [
        "1",
        "4",
        "12"
      ],
      "follows": "payment_plan",
      "when": {
        "Paid in full": "1",
        "Quarterly": "4",
        "Monthly": "12"
      }
    },
    {
      "name": "payment_frequency",
      "label": "Billed",
      "screen": "billing",
      "control": "select",
      "options": [
        "Once",
        "Every 3 months",
        "Every month"
      ],
      "follows": "payment_plan",
      "when": {
        "Paid in full": "Once",
        "Quarterly": "Every 3 months",
        "Monthly": "Every month"
      }
    },
    {
      "name": "autopay_discount",
      "label": "Autopay Discount",
      "screen": "billing",
      "control": "select",
      "options": [
        "Yes",
        "No"
      ],
      "follows": "payment_plan",
      "when": {
        "Paid in full": "No",
        "Quarterly": [
          "Yes",
          "No"
        ],
        "Monthly": "Yes"
      }
    },
    {
      "name": "paperless_billing",
      "label": "Paperless Billing",
      "screen": "billing",
      "control": "checkbox"
    },
    {
      "name": "effective_date",
      "label": "Policy Effective Date",
      "screen": "billing",
      "control": "date",
      "required": true
    }
  ]
}
