{
  "name": "auto_insurance_quote",
  "screens": [
    {
      "id": "driver",
      "title": "Driver"
    },
    {
      "id": "vehicle",
      "title": "Vehicle"
    },
    {
      "id": "coverage",
      "title": "Coverage"
    },
    {
      "id": "history",
      "title": "History"
    },
    {
      "id": "billing",
      "title": "Billing"
    }
  ],
  "fields": [
    {
      "name": "driver_first_name",
      "label": "First Name",
      "screen": "driver",
      "group": "driver",
      "required": true,
      "max_length": 40
    },
    {
      "name": "driver_last_name",
      "label": "Last Name",
      "screen": "driver",
      "group": "driver",
      "required": true,
      "max_length": 40
    },
    {
      "name": "driver_date_of_birth",
      "label": "Date of Birth",
      "screen": "driver",
      "group": "driver",
      "control": "date",
      "required": true
    },
    {
      "name": "driver_email",
      "label": "Email",
      "screen": "driver",
      "group": "driver",
      "max_length": 80
    },
    {
      "name": "driver_phone",
      "label": "Mobile Phone",
      "screen": "driver",
      "group": "driver",
      "required": true,
      "placeholder": "(555) 555-0100"
    },
    {
      "name": "marital_status",
      "label": "Marital Status",
      "screen": "driver",
      "control": "select",
      "required": true,
      "options": [
        "Single",
        "Married",
        "Domestic partner",
        "Widowed"
      ]
    },
    {
      "name": "garaging_street",
      "label": "Garaging Street",
      "screen": "driver",
      "group": "driver",
      "required": true,
      "max_length": 60
    },
    {
      "name": "garaging_city",
      "label": "Garaging City",
      "screen": "driver",
      "group": "driver",
      "required": true,
      "max_length": 40
    },
    {
      "name": "garaging_state",
      "label": "Garaging State",
      "screen": "driver",
      "group": "driver",
      "control": "select",
      "required": true,
      "options": [
        "AZ",
        "CA",
        "CO",
        "FL",
        "IL",
        "NY",
        "TX",
        "WA"
      ]
    },
    {
      "name": "garaging_postal_code",
      "label": "Garaging ZIP",
      "screen": "driver",
      "group": "driver",
      "required": true,
      "pattern": "\\d{5}"
    },
    {
      "name": "license_state",
      "label": "License State",
      "screen": "driver",
      "control": "select",
      "required": true,
      "options": [
        "AZ",
        "CA",
        "CO",
        "FL",
        "IL",
        "NY",
        "TX",
        "WA"
      ],
      "follows": "garaging_state",
      "when": {
        "AZ": "AZ",
        "CA": "CA",
        "CO": "CO",
        "FL": "FL",
        "IL": "IL",
        "NY": "NY",
        "TX": "TX",
        "WA": "WA"
      },
      "help_text": "The policy requires the licence to be issued where the car is garaged."
    },
    {
      "name": "license_status",
      "label": "License Status",
      "screen": "driver",
      "control": "select",
      "required": true,
      "options": [
        "Valid",
        "Restricted",
        "Suspended"
      ]
    },
    {
      "name": "sr22_required",
      "label": "SR-22 Filing Required",
      "screen": "driver",
      "control": "select",
      "options": [
        "Yes",
        "No"
      ],
      "follows": "license_status",
      "when": {
        "Valid": "No",
        "Restricted": "Yes",
        "Suspended": "Yes"
      }
    },
    {
      "name": "years_licensed",
      "label": "Years Licensed",
      "screen": "driver",
      "control": "number",
      "minimum": 0,
      "maximum": 70
    },
    {
      "name": "vehicle_year",
      "label": "Model Year",
      "screen": "vehicle",
      "control": "number",
      "required": true,
      "minimum": 2008,
      "maximum": 2026
    },
    {
      "name": "vehicle_make",
      "label": "Make",
      "screen": "vehicle",
      "control": "select",
