{
  "name": "member_enrollment",
  "screens": [
    {"id": "member", "title": "Member"},
    {"id": "coverage", "title": "Coverage"},
    {"id": "dependent", "title": "Dependent"}
  ],
  "fields": [
    {"name": "member_prefix", "label": "Title", "screen": "member", "group": "member",
     "semantic_type": "prefix",
     "options": ["Mr.", "Ms.", "Mrs.", "Mx.", "Dr."]},
    {"name": "member_first_name", "label": "First Name", "screen": "member",
     "group": "member", "required": true, "max_length": 40},
    {"name": "member_middle_name", "label": "Middle Name", "screen": "member",
     "group": "member", "max_length": 40},
    {"name": "member_middle_initial", "label": "MI", "screen": "member",
     "group": "member", "semantic_type": "middle_name", "max_length": 1},
    {"name": "member_last_name", "label": "Last Name", "screen": "member",
     "group": "member", "required": true, "max_length": 40},
    {"name": "member_full_name", "label": "Name as it should appear on the card",
     "screen": "member", "group": "member", "semantic_type": "full_name",
     "required": true, "max_length": 90},
    {"name": "member_date_of_birth", "label": "Date of Birth", "screen": "member",
     "group": "member", "semantic_type": "date_of_birth", "required": true},
    {"name": "member_age", "label": "Age", "screen": "member", "group": "member",
     "semantic_type": "age", "required": true},
    {"name": "member_gender", "label": "Gender", "screen": "member", "group": "member",
     "options": ["Female", "Male", "Non-binary", "Prefer not to say"]},
    {"name": "member_ssn", "label": "Social Security Number", "screen": "member",
     "group": "member", "semantic_type": "ssn", "required": true},
    {"name": "member_email", "label": "Email", "screen": "member", "group": "member",
     "semantic_type": "email", "required": true, "max_length": 80},
    {"name": "member_phone", "label": "Phone", "screen": "member", "group": "member",
     "semantic_type": "phone"},

    {"name": "home_street", "label": "Street Address", "screen": "member",
     "group": "home", "semantic_type": "street_address", "required": true,
     "max_length": 60},
    {"name": "home_city", "label": "City", "screen": "member", "group": "home",
     "semantic_type": "city", "required": true, "max_length": 40},
    {"name": "home_state", "label": "State", "screen": "member", "group": "home",
     "semantic_type": "state", "required": true, "max_length": 2,
     "options": ["AZ", "CA", "CO", "NV", "NM", "OR", "TX", "UT", "WA"]},
    {"name": "home_postal_code", "label": "ZIP Code", "screen": "member",
     "group": "home", "semantic_type": "postal_code", "required": true,
     "max_length": 10},
    {"name": "home_country", "label": "Country", "screen": "member", "group": "home",
     "semantic_type": "country", "options": ["US"]},

    {"name": "plan_tier", "label": "Plan", "screen": "coverage",
     "options": ["Bronze", "Silver", "Gold", "Platinum"], "required": true},
    {"name": "coverage_level", "label": "Who is covered", "screen": "coverage",
     "options": ["Employee only", "Employee + spouse", "Employee + children", "Family"],
     "required": true},
    {"name": "policy_number", "label": "Policy Number", "screen": "coverage",
     "semantic_type": "policy_number", "required": true, "max_length": 20},
    {"name": "group_number", "label": "Group Number", "screen": "coverage",
     "semantic_type": "group_number", "max_length": 12},
    {"name": "member_id", "label": "Member ID", "screen": "coverage",
     "semantic_type": "member_id", "required": true, "max_length": 16},
    {"name": "effective_date", "label": "Effective Date", "screen": "coverage",
     "semantic_type": "date", "required": true},
    {"name": "monthly_premium", "label": "Monthly Premium", "screen": "coverage",
     "semantic_type": "currency_amount", "minimum": 0, "maximum": 2000},
    {"name": "employer_company", "label": "Employer", "screen": "coverage",
     "group": "employer", "semantic_type": "company", "max_length": 60},

    {"name": "dependent_first_name", "label": "First Name", "screen": "dependent",
     "group": "dependent", "semantic_type": "first_name", "max_length": 40},
    {"name": "dependent_last_name", "label": "Last Name", "screen": "dependent",
     "group": "dependent", "semantic_type": "last_name", "max_length": 40},
    {"name": "dependent_full_name", "label": "Dependent Name", "screen": "dependent",
     "group": "dependent", "semantic_type": "full_name", "max_length": 90},
    {"name": "dependent_date_of_birth", "label": "Date of Birth", "screen": "dependent",
     "group": "dependent", "semantic_type": "date_of_birth"},
    {"name": "dependent_relationship", "label": "Relationship", "screen": "dependent",
     "group": "dependent",
     "options": ["Spouse", "Domestic partner", "Child", "Stepchild"]},
    {"name": "consent_to_terms", "label": "I agree to the plan terms",
     "screen": "dependent", "semantic_type": "boolean", "required": true}
  ]
}
